# ==============================================================================
# CommunityFix - Project Environment Configuration Template
# ==============================================================================

# Backend (Flask) Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-super-secret-random-key-in-production
PORT=5000
HOST=0.0.0.0

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=communityfix_db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite + React) Configuration
VITE_API_BASE_URL=http://localhost:5000
