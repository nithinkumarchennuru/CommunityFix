# Frontend Environment Variables Template
VITE_API_BASE_URL=http://127.0.0.1:5000

# Configure relative paths only after the backend authentication contract is defined.
VITE_AUTH_LOGIN_ENDPOINT=
VITE_AUTH_REGISTER_ENDPOINT=
# Optional; an unset value clears the frontend session without a server logout request.
VITE_AUTH_LOGOUT_ENDPOINT=
