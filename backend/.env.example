# ==============================================================================
# CommunityFix - Backend Environment Configuration Template
# Copy this file to '.env' and fill in your local credentials.
# NOTE: Do NOT commit your actual '.env' file containing real secrets to Git.
# ==============================================================================

# Flask Server Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-super-secret-random-key-in-production
PORT=5000
HOST=0.0.0.0

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=communityfix_db

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
